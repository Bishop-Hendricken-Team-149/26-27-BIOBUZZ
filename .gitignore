# Built application files
*.apk
*.aar
*.ap_
*.aab

!libs/*.aar

# Files for the ART/Dalvik VM
*.dex

# Java/JDK files
*.class
*.hprof

# Generated files
bin/
gen/
out/
#  Uncomment the following line in case you need and you don't have the release build type files in your app
# release/

# Gradle files
.gradle/
build/

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ
*.iml
.idea/

# For Mac users
.DS_Store

# Keystore files
# Uncomment the following lines if you do not want to check your keystore files in.
#*.jks
#*.keystore

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild
.cxx/

# Google Services (e.g. APIs or Firebase)
# google-services.json

# Freeline
freeline.py
freeline/
freeline_project_description.json

# fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output
fastlane/readme.md

# Version control
vcs.xml

# lint
lint/intermediates/
lint/generated/
lint/outputs/
lint/tmp/
# lint/reports/
# ---- HIVE-QUEEN CAD workspace (Team 149) ----
# cad/out holds the BOM, gate report and renders: re-include it (the FTC rule above ignores every out/)
!cad/out/
# scratch, probes and the archived v11 deliverables
cad/tmp/
cad/_archive_v11/
# full-robot STEP/GLB exports exceed or approach GitHub's 100 MB limit; the master model lives in
# Fusion 360 (BHHS FTC 149 / Default Project / FTC 26-27 / HIVE QUEEN v111426m) and re-exports with cad/export_v12.py
cad/STEP/*.step
cad/out/*.step
cad/GLB/*.glb
# third-party vendor STEP/ZIP files (~390 MB): re-download them, see cad/vendor/README.md
cad/vendor/*
!cad/vendor/README.md
__pycache__/
